      },
      "description": "Len kompresor, bez ponoriek a obehového čerpadla; zobrazené pri otáčkach nad 30 rps.\nPodľa TČ: výkon / príkon, ktoré počíta pCO (A444 / A445). Výkon je modelový, vychádza okolo 80 % Carnota, preto je optimistický.\nOdhad: 0,475 × Carnot z kondenzačnej a výparnej teploty.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mastertherm_heating_capacity_watts{job=\"mastertherm-ubytovna\"} / mastertherm_power_input_watts{job=\"mastertherm-ubytovna\"} and on() mastertherm_compressor_speed_rps{job=\"mastertherm-ubytovna\"} > 30",
          "legendFormat": "podľa TČ"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "0.475 * (mastertherm_temperature_celsius{job=\"mastertherm-ubytovna\",sensor=\"condensing\"} + 273.15) / ignoring(sensor) (mastertherm_temperature_celsius{job=\"mastertherm-ubytovna\",sensor=\"condensing\"} - ignoring(sensor) mastertherm_temperature_celsius{job=\"mastertherm-ubytovna\",sensor=\"evaporating\"}) and on() mastertherm_compressor_speed_rps{job=\"mastertherm-ubytovna\"} > 30",
          "legendFormat": "odhad (0,475 × Carnot)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "odhad (0,475 × Carnot)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
